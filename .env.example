# Sàn Quẩy Live - Cấu hình Biến Môi Trường (.env)

# Cổng mạng server lắng nghe (mặc định 3000)
PORT=3000
HOST=0.0.0.0

# Mật khẩu quản trị viên trang /admin (BẮT BUỘC đặt chuỗi bí mật, không commit)
ADMIN_PASSWORD=SanQuayLiveAdmin2026!

# Thư mục lưu trữ dữ liệu JSON (donors, gift-log, settings, music)
DATA_DIR=./data

# Giới hạn số lượng nhân vật hiển thị cùng lúc trên sàn nhảy (mặc định 80)
MAX_AVATARS=80

# Số phút người xem không tương tác trước khi rời sàn nhảy (mặc định 10 phút)
AVATAR_IDLE_MINUTES=10

# Hệ số công thức tính cấp độ (level = min(100, floor(sqrt(XP / LEVEL_FACTOR))))
LEVEL_FACTOR=10

# Khóa ký kết nối TikTok nếu cần (không bắt buộc)
TIKTOK_SIGN_API_KEY=

# Khóa Google YouTube Data API để tải playlist lớn (không bắt buộc)
YOUTUBE_API_KEY=

# Chế độ chỉ chạy giả lập (1 = bật cho CI/smoke test, 0 = bình thường)
DEMO_ONLY=0

# URL giữ server luôn thức (áp dụng cho Render / cloud free tier)
KEEP_ALIVE_URL=
KEEP_ALIVE=

# CORS cho Socket.IO và API (* khi dev/test, hoặc tên miền chính xác khi deploy)
CORS_ORIGIN=*
